# Copy to a file outside the repository and export it. Do not commit real values.
# Nexus Server 0.3.0-alpha reads only the environment. Nothing here belongs in the desktop build.

# Listen address. Loopback is the safe default until you put TLS in front.
NEXUS_BIND=127.0.0.1:8787

# SQLite file. Treat it as a secret: it stores session hashes and in-progress device codes.
NEXUS_DATABASE=/var/lib/nexus-server/nexus.sqlite

# Numeric GitHub user ids that are admins. Logins are not accepted here because they can change.
# Find an id with: https://api.github.com/users/<login>
NEXUS_ADMIN_GITHUB_IDS=12345678

# OAuth App client id. The desktop does not need this.
NEXUS_GITHUB_CLIENT_ID=

# OAuth App client secret. Server only. Never put this in the launcher.
NEXUS_GITHUB_CLIENT_SECRET=

# Fine-grained or classic token that can read release assets for the private app repos.
# Server only. Public apps still work when this is empty. Private downloads do not.
NEXUS_GITHUB_RELEASE_TOKEN=

# Session lifetime in hours. Default is 720 (30 days). Maximum is 2160.
NEXUS_SESSION_TTL_HOURS=720
